{
	"$schema": "https://unpkg.com/jsrepo@2.4.2/schemas/registry-config.json",
	"name": "@jwyce/test",
	"version": "0.0.1",
	"readme": "README.md",
	"defaultPaths": {
		"blocks": "$lib/blocks",
		"ui": "$lib/components/ui",
		"hooks": "$lib/hooks",
		"utils": "$lib/utils"
	},
	"configFiles": [
		{
			"name": "app.css",
			"path": "./src/app.css",
			"expectedPath": "./src/app.css",
			"optional": false,
			"dependencies": [],
			"devDependencies": ["tailwindcss@^4.1.11", "tw-animate-css@^1.3.4"]
		}
	],
	"dirs": ["./src/lib/components", "./src/lib", "src"],
	"includeBlocks": [],
	"includeCategories": ["ui", "blocks", "utils", "hooks"],
	"excludeBlocks": [],
	"excludeCategories": ["components"],
	"doNotListBlocks": [],
	"doNotListCategories": [],
	"listBlocks": ["pokemon-card"],
	"listCategories": [],
	"excludeDeps": [],
	"preview": false,
	"includeDocs": false
}
